# SearXNG.

# Base domain. Used for SEARXNG_BASE_URL (https://search.$DOMAIN/). Set it to
# the domain you serve the stack on.
DOMAIN=example.com
TZ=Europe/London

# uWSGI sizing — bump on a busy/multi-user instance, fine to leave as-is.
# SEARXNG_WORKERS=4
# SEARXNG_THREADS=4

# No secret to set here: on first run the image generates settings.yml with a
# random secret_key into $STORAGE_ROOT/searxng/. Edit that file to customise
# engines / enable the JSON API, then `./scripts/manage.sh restart`.

# STORAGE_ROOT is read from the repo-root .env by ./scripts/manage.sh.
# If you run podman-compose directly, set it here too (else data/ is used).
# STORAGE_ROOT=/srv/storage
