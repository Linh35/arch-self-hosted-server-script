# Speaches — speech-to-text server (faster-whisper, CPU).

# Base domain. The stack is reached at stt.$DOMAIN (via Caddy) or :8093 direct.
DOMAIN=example.com
TZ=Europe/London

# Default Whisper model (HuggingFace faster-whisper CTranslate2 repo id). This is
# what PRELOAD_MODELS pulls at startup and what you pass as `model=` in the API.
# Bulgarian-capable picks, slow→fast / accurate→light on this CPU:
#   Systran/faster-whisper-large-v3   best accuracy, slowest
#   Systran/faster-whisper-medium     default — good Bulgarian, slower than real-time
#   Systran/faster-whisper-small      ~real-time-ish, decent on clear audio
# WHISPER_MODEL=Systran/faster-whisper-medium

# Language the custom web UI's Speech-to-Text tab transcribes (ISO 639-1). The UI
# has no language selector; it's fixed here. Default bg (Bulgarian). The HTTP API
# is unaffected — callers pass their own `language`.
# STT_LANGUAGE=bg

# CTranslate2 CPU threads. Defaults to 4 (the box's physical cores). Raising it
# toward 8 (the hyperthreads) usually doesn't speed int8 up and steals from the
# other stacks.
# WHISPER_CPU_THREADS=4

# Gradio web UI at stt.$DOMAIN/. Set to false to run API-only (lighter).
# SPEACHES_ENABLE_UI=true

# Models must be downloaded once before use (this image does NOT lazy-download on
# the first transcription — it returns "not installed locally"). After bring-up,
# install the default model (one-time, ~1.5 GB; slash in the id is URL-encoded):
#   curl -X POST http://localhost:8093/v1/models/Systran%2Ffaster-whisper-medium
# It then persists in $STORAGE_ROOT/speaches, and WHISPER__TTL=-1 (set in the
# compose) keeps it resident in RAM across requests. List installed models with
#   curl http://localhost:8093/v1/models

# STORAGE_ROOT is read from the repo-root .env by ./scripts/manage.sh; the
# downloaded models cache lives under $STORAGE_ROOT/speaches. If you run
# podman-compose directly, set it here too (else data/ is used).
# STORAGE_ROOT=/srv/storage
