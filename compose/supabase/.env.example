# Self-hosted Supabase (vendored from supabase/docker, adapted for this repo).
# Generate the secrets/keys below, then bring up. The browser-facing API +
# Studio dashboard are served via Kong at SUPABASE_PUBLIC_URL (Caddy fronts it).
# anon/service keys are HS256 JWTs signed with JWT_SECRET — use utils/generate-keys.sh.

############ Stash self-hosted Supabase — adapted from supabase/docker .env.example
COMPOSE_FILE=docker-compose.yml

POSTGRES_PASSWORD=generate: openssl rand -hex 24
JWT_SECRET=generate: openssl rand -base64 30 (>=32 chars)
ANON_KEY=generate-with-utils/generate-keys.sh (HS256 JWT, role=anon)
SERVICE_ROLE_KEY=generate-with-utils/generate-keys.sh (HS256 JWT, role=service_role)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
SECRET_KEY_BASE=generate: openssl rand -base64 48
VAULT_ENC_KEY=generate: openssl rand -hex 16
PG_META_CRYPTO_KEY=generate: openssl rand -hex 16
LOGFLARE_PUBLIC_ACCESS_TOKEN=generate: openssl rand -hex 16
LOGFLARE_PRIVATE_ACCESS_TOKEN=generate: openssl rand -hex 16
S3_PROTOCOL_ACCESS_KEY_ID=generate: openssl rand -hex 16
S3_PROTOCOL_ACCESS_KEY_SECRET=generate: openssl rand -hex 32

############ Public URLs (the browser hits Kong at this hostname)
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com
SITE_URL=https://stash.example.com
ADDITIONAL_REDIRECT_URLS=https://stash.example.com

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=stash
POOLER_DB_POOL_SIZE=5

STUDIO_DEFAULT_ORGANIZATION=Stash
STUDIO_DEFAULT_PROJECT=Stash
OPENAI_API_KEY=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Stash
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

GLOBAL_S3_BUCKET=stub
REGION=stub
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=generate: openssl rand -hex 12
STORAGE_TENANT_ID=stash

FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=stub
GOOGLE_PROJECT_NUMBER=stub

KONG_HTTP_PORT=8200
KONG_HTTPS_PORT=8201
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
IMGPROXY_AUTO_WEBP=true
PROXY_DOMAIN=supabase.example.com
CERTBOT_EMAIL=admin@example.com
