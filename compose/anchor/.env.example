# Anchor (self-hosted notes).

# Base domain — used for APP_URL (https://notes.$DOMAIN).
DOMAIN=example.com
TZ=Europe/London

# Auth token secret. Generate one: openssl rand -hex 32
ANCHOR_JWT_SECRET=change_me_openssl_rand_hex_32

# Password for the bundled PostgreSQL (kept inside the container's /data).
ANCHOR_PG_PASSWORD=change_me

# Signup mode: enabled | review | disabled. Start "enabled", create your
# account, then set "disabled" and restart to lock signups.
ANCHOR_USER_SIGNUP=enabled

# STORAGE_ROOT is read from the repo-root .env by ./scripts/manage.sh.
# If you run podman-compose directly, set it here too (else data/ is used).
# STORAGE_ROOT=/srv/storage
