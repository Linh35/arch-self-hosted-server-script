# Paperless-ngx.

# Base domain. Used for PAPERLESS_URL (https://docs.$DOMAIN) so login over the
# Caddy name works. Set it to the domain you serve the stack on.
DOMAIN=example.com
TZ=Europe/London

# UID/GID the paperless process runs as. Keep NON-root: Paperless (like
# FreshRSS) runs `usermod` on this and refuses 0. The container's root-stage
# init chowns its data dirs to this uid on first boot, so it can write under
# STORAGE_ROOT regardless of host ownership.
PUID=1000
PGID=1000

# Django secret. REQUIRED — generate one: openssl rand -hex 32
PAPERLESS_SECRET_KEY=change_me_openssl_rand_hex_32

# Postgres password (used by both the db container and Paperless).
PAPERLESS_DB_PASSWORD=change_me

# First-run superuser. Created automatically on first start; change the
# password here before that first boot (or in the web UI afterwards).
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change_me

# OCR language(s), ISO 639-2/T codes joined with '+', e.g. eng, deu, eng+vie.
PAPERLESS_OCR_LANGUAGE=eng

# Set to a number of seconds (e.g. 60) only if inotify doesn't fire on your
# filesystem and dropped files aren't picked up. 0 = instant inotify pickup.
PAPERLESS_CONSUMER_POLLING=0

# STORAGE_ROOT is read from the repo-root .env by ./scripts/manage.sh.
# If you run podman-compose directly, set it here too (else data/ is used).
# STORAGE_ROOT=/srv/storage
