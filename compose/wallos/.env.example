# Wallos (subscription tracker).
TZ=Europe/London

# UID/GID the web user runs as (the image's startup chowns the mounted db/logos
# to this). 1000 matches the rest of the stack.
PUID=1000
PGID=1000

# No DOMAIN needed — Wallos works on any host with no base-URL setting.
# STORAGE_ROOT is read from the repo-root .env by ./scripts/manage.sh.
# If you run podman-compose directly, set it here too (else data/ is used).
# STORAGE_ROOT=/srv/storage
